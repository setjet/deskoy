{
  "name": "deskoy-app",
  "productName": "Deskoy",
  "version": "2.0.0",
  "description": "My Electron application description",
  "private": true,
  "scripts": {
    "build:icons": "node scripts/build-icons.cjs",
    "build:install-gif": "node scripts/build-install-gif.cjs",
    "build:installer-assets": "node scripts/build-installer-assets.cjs",
    "dev": "vite",
    "start": "tauri dev",
    "build": "vite build",
    "tauri:build": "tauri build",
    "tauri:build:unsigned": "tauri build --no-bundle",
    "cli:build": "cargo build --manifest-path cli/Cargo.toml",
    "cli:build:release": "cargo build --manifest-path cli/Cargo.toml --release --locked",
    "cli:test": "cargo test --manifest-path cli/Cargo.toml",
    "lint": "tsc --noEmit",
    "test:defender-ui": "node --test scripts/test-defender-ui.cjs",
    "test:licensing-ui": "node --test scripts/test-licensing-ui.cjs",
    "test:local-assets": "node --test scripts/test-local-assets.cjs"
  },
  "keywords": [],
  "author": "User",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^5.0.0",
    "bmp-js": "^0.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "png-to-ico": "^2.1.8",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.5",
    "typescript": "~5.4.5",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "thinking-orbs": "^0.3.1"
  }
}
